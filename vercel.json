{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python scripts/prepare_vercel_assets.py",
  "outputDirectory": "public",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "functions": {
    "wsgi.py": {
      "excludeFiles": "{public/**,c08/web/assets/**,c08/web/fonts/**,c08/web/terrain/**,c08/web/vendor/**,c08/web/*.{css,js,webmanifest}}"
    }
  }
}
