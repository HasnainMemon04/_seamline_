{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python scripts/prepare_vercel_assets.py",
  "outputDirectory": "public",
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "functions": {
    "wsgi.py": {
      "includeFiles": "c08/web/**",
      "excludeFiles": "public/**"
    }
  }
}
